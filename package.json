{
  "name": "@openlide/geomstore",
  "version": "0.2.1",
  "description": "轻量级微信小程序状态管理库 - 简洁、高效、易用",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/core/store/index.d.ts",
      "require": "./dist/core/store/index.js"
    },
    "./hooks": {
      "types": "./dist/core/hooks/index.d.ts",
      "require": "./dist/core/hooks/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "require": "./dist/plugins/index.js"
    },
    "./plugins/devtools": {
      "types": "./dist/plugins/devtools/index.d.ts",
      "require": "./dist/plugins/devtools/index.js"
    },
    "./plugins/performance": {
      "types": "./dist/plugins/performance/index.d.ts",
      "require": "./dist/plugins/performance/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "require": "./dist/integrations/index.js"
    },
    "./integrations/enterprise": {
      "types": "./dist/integrations/enterprise/index.d.ts",
      "require": "./dist/integrations/enterprise/index.js"
    },
    "./error": {
      "types": "./dist/core/error/index.d.ts",
      "require": "./dist/core/error/index.js"
    },
    "./compose": {
      "types": "./dist/core/compose/index.d.ts",
      "require": "./dist/core/compose/index.js"
    },
    "./selectors": {
      "types": "./dist/core/selector/index.d.ts",
      "require": "./dist/core/selector/index.js"
    },
    "./snapshot": {
      "types": "./dist/core/snapshot/index.d.ts",
      "require": "./dist/core/snapshot/index.js"
    },
    "./performance": {
      "types": "./dist/core/performance/index.d.ts",
      "require": "./dist/core/performance/index.js"
    },
    "./actions": {
      "types": "./dist/core/action/index.d.ts",
      "require": "./dist/core/action/index.js"
    },
    "./cache": {
      "types": "./dist/core/cache/index.d.ts",
      "require": "./dist/core/cache/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "store",
    "hooks",
    "plugins",
    "integrations",
    "error",
    "compose",
    "selectors",
    "snapshot",
    "performance",
    "actions",
    "cache"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "build": "tsc -p tsconfig.cjs.json && node scripts/postbuild-dist.cjs",
    "stubs": "node scripts/generate-subpath-stubs.cjs",
    "stubs:clean": "node scripts/generate-subpath-stubs.cjs --clean",
    "prepack": "node scripts/generate-subpath-stubs.cjs",
    "postpack": "node scripts/generate-subpath-stubs.cjs --clean",
    "prepublishOnly": "pnpm test && pnpm build",
    "lint": "eslint src tests --ext .ts",
    "lint:ci": "eslint src tests --ext .ts --max-warnings 70",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:examples": "tsc --noEmit -p tools/tsconfig.examples.json",
    "typecheck:src": "tsc --noEmit"
  },
  "keywords": [
    "state-management",
    "miniprogram",
    "wechat",
    "weixin",
    "skyline",
    "typescript",
    "store",
    "lightweight"
  ],
  "author": "openlide",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "repository": {
    "type": "git",
    "url": "https://github.com/openlide/geomstore.git"
  },
  "bugs": {
    "url": "https://github.com/openlide/geomstore/issues"
  },
  "homepage": "https://github.com/openlide/geomstore#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
