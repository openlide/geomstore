    "typecheck": "tsc --noEmit",
    "bench": "tsc && node dist/smoke.js"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
