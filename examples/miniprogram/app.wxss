/* Demo 样式：只服务于演示，与库无关 */
.container {
  padding: 32rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.muted {
  color: #888;
  font-size: 26rpx;
}
.hint {
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f6f6f6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #555;
}
.item-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}
