# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
*.log
*.tsbuildinfo

# 说明：子路径转发 stub（store/ hooks/ plugins/ 等）由 prepack 钩子在打包发布时
# 生成、postpack 清理，不落盘到仓库，故无需忽略规则。详见 scripts/generate-subpath-stubs.cjs

# Test coverage
coverage/
coverage-report.json
.nyc_output/
coverage-*.json

# IDE
# .codebuddy 整体保持忽略（内含会话与本地数据），仅放开 skills 目录，使 project skill 可随仓库分发
.codebuddy/*
!.codebuddy/skills/
!.codebuddy/skills/**
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# 示例工程：本地试验目录，不随仓库分发（与 src 下的 *.example.ts 无关，后者照常跟踪）。
# 已在此规则前被跟踪的 12 个文件仍在版本控制内；新增示例需显式 git add -f
examples/

# Environment variables
# .env.* 覆盖 .env.local / .env.production / .env.development / .env.test 等全部变体；
# 仅允许签入模板文件 .env.example（不含真实凭据）
.env
.env.*
!.env.example

