{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "miniprogram-api-typings"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
