{
  "name": "@openlide/geomstore",
  "version": "0.9.0",
  "description": "原生微信小程序状态管理库 - 简洁、高效、易用",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "miniprogram": "dist-weapp",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "default": "./dist/integrations/index.js"
    },
    "./extras": {
      "types": "./dist/extras/index.d.ts",
      "default": "./dist/extras/index.js"
    },
    "./extras/snapshot": {
      "types": "./dist/extras/snapshot.d.ts",
      "default": "./dist/extras/snapshot.js"
    },
    "./extras/selector": {
      "types": "./dist/extras/selector.d.ts",
      "default": "./dist/extras/selector.js"
    },
    "./extras/performance": {
      "types": "./dist/extras/performance.d.ts",
      "default": "./dist/extras/performance.js"
    },
    "./extras/action": {
      "types": "./dist/extras/action.d.ts",
      "default": "./dist/extras/action.js"
    },
    "./extras/plugins": {
      "types": "./dist/extras/plugins.d.ts",
      "default": "./dist/extras/plugins.js"
    },
    "./extras/error": {
      "types": "./dist/extras/error/index.d.ts",
      "default": "./dist/extras/error/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-weapp",
    "store",
    "hooks",
    "plugins",
    "integrations",
    "compose",
    "selectors",
    "snapshot",
    "performance",
    "actions",
    "cache",
    "error"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild-dist.mjs",
    "build:min": "pnpm build && node scripts/minify-dist.mjs",
    "build:release": "pnpm build && node scripts/minify-dist.mjs --strict",
    "build:weapp": "node scripts/build-weapp.mjs",
    "verify:weapp": "node scripts/verify-weapp-bundle.mjs",
    "stubs": "node scripts/generate-subpath-stubs.mjs",
    "stubs:clean": "node scripts/generate-subpath-stubs.mjs --clean",
    "skill:api": "node scripts/generate-skill-api-reference.mjs",
    "prepack": "node scripts/generate-subpath-stubs.mjs",
    "postpack": "node scripts/generate-subpath-stubs.mjs --clean",
    "prepublishOnly": "pnpm test && pnpm run build:release && pnpm run build:weapp && pnpm run verify:weapp",
    "lint": "eslint src tests --ext .ts",
    "lint:ci": "eslint src tests --ext .ts --max-warnings 0",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\" \"docs/**/*.md\" \"packages/**/*.md\" \"skills/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\" \"docs/**/*.md\" \"packages/**/*.md\" \"skills/**/*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:examples": "tsc --noEmit -p tools/tsconfig.examples.json",
    "typecheck:src": "tsc --noEmit"
  },
  "keywords": [
    "state-management",
    "miniprogram",
    "wechat",
    "weixin",
    "skyline",
    "typescript",
    "store",
    "lightweight"
  ],
  "author": "openlide",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "repository": {
    "type": "git",
    "url": "https://github.com/openlide/geomstore.git"
  },
  "bugs": {
    "url": "https://github.com/openlide/geomstore/issues"
  },
  "homepage": "https://github.com/openlide/geomstore#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
