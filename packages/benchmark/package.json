{
  "name": "@openlide/geomstore-benchmark",
  "version": "1.0.0",
  "description": "GeomStore 基准测试工具包 - 提供全面的性能基准测试功能",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "private": true,
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "benchmark",
    "performance",
    "state-management",
    "geomstore"
  ],
  "author": "GeomStore Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openlide/GeomStore.git",
    "directory": "packages/benchmark"
  },
  "peerDependencies": {
    "@openlide/geomstore": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
